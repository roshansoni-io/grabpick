# GrabPick environment configuration
# Copy to .env and adjust values for your setup.

# PostgreSQL (pgvector) connection URL
DATABASE_URL=postgresql+psycopg://localhost:5432/grabpick

# ONNX model paths (relative to the project root)
GRABPICK_DETECTOR_MODEL=model/detector/scrfd_500m_gnkps.onnx

GRABPICK_EMBEDDING_MODEL=model/embedding/edgeface_xs_gamma_06.onnx

# Face recognition match threshold (cosine similarity, 0.0-1.0)
GRABPICK_THRESHOLD=0.45